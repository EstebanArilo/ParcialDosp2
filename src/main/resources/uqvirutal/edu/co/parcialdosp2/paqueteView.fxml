<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="550.0" prefWidth="750.0" spacing="12.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/17.0.2-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uqvirutal.edu.co.parcialdosp2.viewController.PaqueteViewController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <children>
        <!-- Encabezado de la Vista -->
        <VBox alignment="CENTER" prefHeight="50.0" prefWidth="710.0" style="-fx-background-color: #1e293b; -fx-background-radius: 8px; -fx-padding: 10px;">
            <children>
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Configuración de Paquetes (Patrón Composite)" />
            </children>
        </VBox>

        <!-- Panel de Formulario para Crear Paquete -->
        <VBox spacing="8.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8px; -fx-padding: 12px; -fx-border-color: #cbd5e1; -fx-border-radius: 8px;">
            <children>
                <Label style="-fx-font-weight: bold; -fx-text-fill: #0284c7; -fx-font-size: 14px;" text="Gestión de Paquetes Tecnológicos" />

                <HBox spacing="10.0">
                    <children>
                        <TextField fx:id="txtNombrePaquete" promptText="Nombre del Paquete" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtDescripcionPaquete" promptText="Descripción general" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Button minHeight="32.0" onAction="#onCrearPaquete" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5px;" text="📦 Crear Paquete Vacío" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Tabla de Paquetes Registrados -->
        <TableView fx:id="tblPaquetes" prefHeight="200.0" prefWidth="710.0" style="-fx-background-radius: 5px;">
            <columns>
                <TableColumn fx:id="colNombrePaquete" prefWidth="220.0" text="Nombre del Paquete" />
                <TableColumn fx:id="colDescripcionPaquete" prefWidth="310.0" text="Descripción" />
                <TableColumn fx:id="colCostoPaquete" prefWidth="178.0" text="Costo Total ($)" />
            </columns>
        </TableView>

        <!-- Botón Volver al Menú Principal -->
        <HBox alignment="CENTER_LEFT">
            <children>
                <Button minHeight="35.0" minWidth="100.0" onAction="#onVolver" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5px;" text="⬅ Volver" />
            </children>
        </HBox>
    </children>
</VBox>