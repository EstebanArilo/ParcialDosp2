<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="750.0" spacing="12.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/17.0.2-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uqvirutal.edu.co.parcialdosp2.viewController.TecnicoViewController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <children>
        <!-- Encabezado de la Vista -->
        <VBox alignment="CENTER" prefHeight="50.0" prefWidth="710.0" style="-fx-background-color: #1e293b; -fx-background-radius: 8px; -fx-padding: 10px;">
            <children>
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Consulta de Técnicos y Cálculo de Costos" />
            </children>
        </VBox>

        <!-- Panel de Selección de Solicitud para Costos -->
        <VBox spacing="8.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8px; -fx-padding: 12px; -fx-border-color: #cbd5e1; -fx-border-radius: 8px;">
            <children>
                <Label style="-fx-font-weight: bold; -fx-text-fill: #0284c7; -fx-font-size: 14px;" text="Cálculo de Costos por Solicitud" />

                <HBox spacing="15.0" alignment="CENTER_LEFT">
                    <children>
                        <ComboBox fx:id="cmbSolicitudesConsulta" promptText="Seleccionar Solicitud" prefWidth="280.0" onAction="#onSeleccionarSolicitud" />

                        <VBox spacing="2.0">
                            <children>
                                <Label text="Costo Servicios:" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
                                <Label fx:id="lblCostoServicios" text="0.0" style="-fx-font-weight: bold; -fx-font-size: 13px;" />
                            </children>
                        </VBox>

                        <VBox spacing="2.0">
                            <children>
                                <Label text="Desplazamiento:" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
                                <Label fx:id="lblCostoDesplazamiento" text="0.0" style="-fx-font-weight: bold; -fx-font-size: 13px;" />
                            </children>
                        </VBox>

                        <VBox spacing="2.0">
                            <children>
                                <Label text="Costo Total:" style="-fx-font-size: 11px; -fx-text-fill: #0284c7;" />
                                <Label fx:id="lblCostoTotal" text="0.0" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #0284c7;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Tabla de Técnicos -->
        <TableView fx:id="tblTecnicos" prefHeight="200.0" prefWidth="710.0" style="-fx-background-radius: 5px;">
            <columns>
                <TableColumn fx:id="colNombreTecnico" prefWidth="250.0" text="Nombre del Técnico" />
                <TableColumn fx:id="colCedulaTecnico" prefWidth="200.0" text="Cédula" />
                <TableColumn fx:id="colEspecialidadTecnico" prefWidth="258.0" text="Especialidad" />
            </columns>
        </TableView>

        <!-- Botón Volver al Menú Principal -->
        <HBox alignment="CENTER_LEFT">
            <children>
                <Button minHeight="35.0" minWidth="100.0" onAction="#onVolver" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5px;" text="⬅ Volver" />
            </children>
        </HBox>
    </children>
</VBox>