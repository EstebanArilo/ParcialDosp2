<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="750.0" spacing="12.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/17.0.2-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uqvirutal.edu.co.parcialdosp2.viewController.ServicioViewController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <children>
        <!-- Encabezado de la Vista -->
        <VBox alignment="CENTER" prefHeight="50.0" prefWidth="710.0" style="-fx-background-color: #1e293b; -fx-background-radius: 8px; -fx-padding: 10px;">
            <children>
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Gestión de Servicios y Complementos (Patrón Decorador)" />
            </children>
        </VBox>

        <!-- Tabla de Servicios Registrados -->
        <TableView fx:id="tblServicios" prefHeight="200.0" prefWidth="710.0" style="-fx-background-radius: 5px;">
            <columns>
                <TableColumn fx:id="colNombre" prefWidth="200.0" text="Servicio" />
                <TableColumn fx:id="colDescripcion" prefWidth="310.0" text="Descripción" />
                <TableColumn fx:id="colCosto" prefWidth="198.0" text="Costo Total" />
            </columns>
        </TableView>

        <!-- Panel de Formulario para Aplicar Complementos (Decorador) -->
        <VBox spacing="8.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8px; -fx-padding: 12px; -fx-border-color: #cbd5e1; -fx-border-radius: 8px;">
            <children>
                <Label style="-fx-font-weight: bold; -fx-text-fill: #0284c7; -fx-font-size: 14px;" text="Aplicar Complemento / Decorador" />

                <HBox spacing="10.0">
                    <children>
                        <TextField fx:id="txtNombreComplemento" promptText="Nombre complemento" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtDescripcionComplemento" promptText="Descripción" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtCostoComplemento" promptText="Costo adicional" prefWidth="120.0" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Button minHeight="32.0" onAction="#onAgregarComplemento" style="-fx-background-color: #0d9488; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5px;" text="✨ Agregar Complemento" />

                        <Label style="-fx-font-weight: bold;" text="Costo Base:" />
                        <Label fx:id="lblCostoBase" text="0.0" style="-fx-text-fill: #334155;" />

                        <Label style="-fx-font-weight: bold;" text="Incremento:" />
                        <Label fx:id="lblIncremento" text="0.0" style="-fx-text-fill: #0d9488;" />

                        <Label style="-fx-font-weight: bold;" text="Costo Final:" />
                        <Label fx:id="lblCostoFinal" text="0.0" style="-fx-text-fill: #0284c7; -fx-font-weight: bold;" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Botón Volver al Menú Principal -->
        <HBox alignment="CENTER_LEFT">
            <children>
                <Button minHeight="35.0" minWidth="100.0" onAction="#onVolver" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5px;" text="⬅ Volver" />
            </children>
        </HBox>
    </children>
</VBox>